# Supabase — get from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # Never expose this on the client

# Hugging Face — get from https://huggingface.co/settings/tokens (free tier)
HF_API_TOKEN=<hf_api_token>

# Google Cloud Speech-to-Text fallback — get from https://console.cloud.google.com/
# Paste the full contents of your service account JSON file as the value
GOOGLE_CLOUD_KEY_FILE={"type":"service_account","project_id":"<project-id>", ...}
GOOGLE_CLOUD_PROJECT_ID=<gcp-project-id>
