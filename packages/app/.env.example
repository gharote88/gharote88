# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# App Configuration
EXPO_PUBLIC_APP_URL=marathi-learning://
EXPO_PUBLIC_APP_ENV=development          # development | production
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000   # dev: localhost | prod: https://your-project.vercel.app

# Speech Recognition
# Web: uses browser Web Speech API (no key needed)
# Mobile: HF Whisper + Google Cloud STT are server-side (keys in api/.env)
# Offline mobile: Vosk model bundled via react-native-vosk (no key needed)
